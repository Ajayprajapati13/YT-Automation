# Python virtual environment
.venv/

# Local machine-specific Claude Code settings
.claude/settings.local.json

# Python bytecode cache
__pycache__/
*.pyc

# Generated video/audio output (large, regenerable)
output/

# Temporary render artifacts (large, regenerable)
temp/

# Logs
logs/
*.log

# Environment / secrets
.env
*.env

# Task handoff worker: local runtime state (machine-specific, not history)
SUPERVISOR/worker/state.json
SUPERVISOR/worker/worker.pid
